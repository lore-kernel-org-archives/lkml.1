> > >     [<c1256bb3>] snd_seq_do_ioctl+0x59/0x78
> > >     [<c1256c11>] snd_seq_kernel_client_ctl+0x2f/0x48
> > >     [<c14c96e1>] snd_seq_oss_create_client+0xf8/0x143
