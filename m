[1]: tracing.sh
#!/bin/sh
cd /debug/tracing
sysctl kernel.latencytop=1
echo kill_pgrp detach_pid\
        >set_ftrace_filter
echo ftrace >current_tracer
echo 1 >tracing_enabled
sleep 60
echo 0 >tracing_enabled
cat trace >/tmp/trace.out
cat latency_trace >/tmp/latencytrace.out
echo "DONE"

