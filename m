> +++ linux-2.6.20/sound/pci/ca0106/ca0106_main.c	        2007-02-09 17:20:37.000000000 +0100
> @@ -1455,6 +1455,8 @@ static int __devinit snd_ca0106_create(i
>  		snd_ca0106_free(chip);
>  		return err;
>  	}
> +
> +	snd_card_set_dev(card, &pci->dev);
>  	*rchip = chip;
>  	return 0;
>  }
