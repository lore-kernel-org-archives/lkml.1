linux-glcc:/sys/kernel/debug/tracing # echo 1 > tracing_enabled 
linux-glcc:/sys/kernel/debug/tracing # cat tracing_enabled 
1
linux-glcc:/sys/kernel/debug/tracing # cat trace
# tracer: sched_switch
#
#           TASK-PID    CPU#    TIMESTAMP  FUNCTION
