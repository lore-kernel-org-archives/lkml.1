mark gross wrote:
> 
> --- a/sound/core/pcm_native.c
> +++ b/sound/core/pcm_native.c
(snip)
> @@ -506,8 +508,8 @@ static int snd_pcm_hw_free(struct snd_pcm_substream *substream)
