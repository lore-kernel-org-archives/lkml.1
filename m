linux-glcc:/sys/kernel/debug/tracing # cat trace
# tracer: sched_switch
#
#           TASK-PID    CPU#    TIMESTAMP  FUNCTION
#              | |       |          |         |
linux-glcc:/sys/kernel/debug/tracing # cat tracing_on 
1
linux-glcc:/sys/kernel/debug/tracing # echo "mark-two" > trace_marker 
linux-glcc:/sys/kernel/debug/tracing # cat tracing_on 
1
linux-glcc:/sys/kernel/debug/tracing # cat trace
# tracer: sched_switch
#
#           TASK-PID    CPU#    TIMESTAMP  FUNCTION
