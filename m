> -	return sound_remove_unit(&chains[3], unit);
> +	sound_remove_unit(&chains[3], unit);
>  }
> 
> 
> @@ -507,7 +507,7 @@ static struct sound_unit *__look_for_unit(int
> chain, int unit)
