#include <unistd.h>
#include <sys/types.h>
#include <time.h>
#include <stdio.h>

int main(int argc, char **argv) {
  uid_t euid, expected;
  if (argc > 1)
    expected = atoi(argv[1]);
  else
    expected = 0;
  euid = geteuid();
  if(euid != expected) {
    time_t t = time(NULL);
    printf("euid:%u at %s", euid, asctime(localtime(&t)));
    return 1;
  } else {
    return 0;
  }
}

