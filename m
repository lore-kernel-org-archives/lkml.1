 	unsigned int gpiostate, gpiomask, gpiodir;
 
+	if (!mask)
+		return;
+
 	gpiostate = snd_hda_codec_read(codec, codec->afg, 0,
 				       AC_VERB_GET_GPIO_DATA, 0);
