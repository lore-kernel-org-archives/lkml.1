-void RateSort(u8 *RateArray, u8 num, u8 mode)
-{
-	u8 i, j, tmp;
-
-	if(mode)
-	{
-		for (i=0; i<(num-1); ++i)
-		{
-			for (j=i+1; j<num; ++j)
-			{
-				if (RateArray[j] < RateArray[i])
-				{
-					//swap
-					tmp = RateArray[i];
-					RateArray[i] = RateArray[j];
-					RateArray[j] = tmp;
-				}
-			}
-		}
-	}
