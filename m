> +	sound_remove_unit(&chains[2], unit);
>  }
> 
>  EXPORT_SYMBOL(unregister_sound_midi);
> @@ -474,7 +474,7 @@ EXPORT_SYMBOL(unregister_sound_midi);
> 
>  void unregister_sound_dsp(int unit)
