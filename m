 sound/soc/codecs/tlv320aic23.c |    2 +-
 sound/soc/omap/omap3evm.c      |    2 +-
 sound/soc/omap/omap3pandora.c  |    3 ++-
 sound/usb/usbmixer.c           |    9 +++++++++
 5 files changed, 14 insertions(+), 3 deletions(-)

